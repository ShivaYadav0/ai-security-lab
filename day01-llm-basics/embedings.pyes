import ollama
import numpy as np

def embed(text):
    return np.array(ollama.embed(model="nomic-embed-text", input=text)["embeddings"][0])

def similarity(a, b):
    return float(a @ b / (np.linalg.norm(a) * np.linalg.norm(b)))

a = embed("Reset my password")
b = embed("I forgot my login")
c = embed("Best pizza toppings")

print("vector length:", len(a))
print("password vs login:", round(similarity(a, b), 3))
print("password vs pizza:", round(similarity(a, c), 3))
